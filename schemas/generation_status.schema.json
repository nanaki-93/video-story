{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "ComfyWorkflow": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "document_type": {
          "const": "comfy_workflow",
          "default": "comfy_workflow",
          "title": "Document Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelBinding"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Models",
          "type": "array"
        },
        "node_definitions": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxProperties": 64,
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "title": "Node Definitions",
          "type": "object"
        },
        "output_nodes": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Output Nodes",
          "type": "array"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "synthetic_fixture": {
          "default": false,
          "title": "Synthetic Fixture",
          "type": "boolean"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        },
        "workflow": {
          "$ref": "#/$defs/HashedFile"
        }
      },
      "required": [
        "schema_version",
        "id",
        "version",
        "description",
        "workflow",
        "models",
        "node_definitions",
        "output_nodes"
      ],
      "title": "ComfyWorkflow",
      "type": "object"
    },
    "GenerationOutput": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "node_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "subfolder": {
          "default": "",
          "title": "Subfolder",
          "type": "string"
        },
        "type": {
          "const": "output",
          "default": "output",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "filename"
      ],
      "title": "GenerationOutput",
      "type": "object"
    },
    "GenerationPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_workflow_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Allowed Workflow Hashes",
          "type": "array"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "endpoint": {
          "default": "http://127.0.0.1:8188",
          "title": "Endpoint",
          "type": "string"
        },
        "max_output_bytes": {
          "default": 67108864,
          "maximum": 268435456,
          "minimum": 1024,
          "title": "Max Output Bytes",
          "type": "integer"
        }
      },
      "title": "GenerationPolicy",
      "type": "object"
    },
    "GenerationRun": {
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "const": "generation_run",
          "default": "generation_run",
          "title": "Document Type",
          "type": "string"
        },
        "downloads": {
          "items": {
            "$ref": "#/$defs/HashedFile"
          },
          "maxItems": 16,
          "title": "Downloads",
          "type": "array"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "imported_assets": {
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "maxItems": 16,
          "title": "Imported Assets",
          "type": "array"
        },
        "manifest": {
          "$ref": "#/$defs/ComfyWorkflow"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/GenerationOutput"
          },
          "maxItems": 16,
          "title": "Outputs",
          "type": "array"
        },
        "prompt_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Prompt Id",
          "type": "string"
        },
        "queue_position": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Position"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "enum": [
            "submitting",
            "unknown",
            "queued",
            "running",
            "succeeded",
            "failed",
            "imported"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "endpoint",
        "prompt_id",
        "manifest",
        "manifest_sha256",
        "state"
      ],
      "title": "GenerationRun",
      "type": "object"
    },
    "HashedFile": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/MediaPath"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "location",
        "sha256",
        "size_bytes"
      ],
      "title": "HashedFile",
      "type": "object"
    },
    "MediaPath": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "root_id": {
          "default": "project",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Root Id",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "MediaPath",
      "type": "object"
    },
    "ModelBinding": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/HashedFile"
        },
        "input_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Input Name",
          "type": "string"
        },
        "node_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "server_name": {
          "title": "Server Name",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "input_name",
        "server_name",
        "file"
      ],
      "title": "ModelBinding",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:generation_status",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "availability": {
      "default": "unchecked",
      "enum": [
        "unchecked",
        "disabled",
        "online",
        "offline"
      ],
      "title": "Availability",
      "type": "string"
    },
    "document_type": {
      "const": "generation_status",
      "default": "generation_status",
      "title": "Document Type",
      "type": "string"
    },
    "message": {
      "default": "",
      "title": "Message",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/GenerationPolicy"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/GenerationRun"
      },
      "title": "Runs",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workflow_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Workflow Hashes",
      "type": "object"
    },
    "workflows": {
      "items": {
        "$ref": "#/$defs/ComfyWorkflow"
      },
      "title": "Workflows",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "policy"
  ],
  "title": "GenerationStatus",
  "type": "object"
}
