{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "body",
            "face"
          ],
          "title": "Channel",
          "type": "string"
        },
        "clip": {
          "$ref": "#/$defs/AssetRef"
        },
        "compatible_body_poses": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Compatible Body Poses",
          "type": "array"
        },
        "end_pose": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "End Pose",
          "type": "string"
        },
        "frame_count": {
          "exclusiveMinimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "loop",
            "one_shot"
          ],
          "title": "Kind",
          "type": "string"
        },
        "loop": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occupies_channels": {
          "items": {
            "enum": [
              "body",
              "face"
            ],
            "type": "string"
          },
          "title": "Occupies Channels",
          "type": "array"
        },
        "requires_props": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Requires Props",
          "type": "object"
        },
        "resulting_props": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Resulting Props",
          "type": "object"
        },
        "start_pose": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Start Pose",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "channel",
        "start_pose",
        "end_pose",
        "kind",
        "frame_count",
        "clip"
      ],
      "title": "Action",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Approval",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "FrameInterval": {
      "additionalProperties": false,
      "properties": {
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        }
      },
      "required": [
        "start_frame",
        "end_frame"
      ],
      "title": "FrameInterval",
      "type": "object"
    },
    "FrameRate": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "exclusiveMinimum": 0,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "exclusiveMinimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "FrameRate",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:action_pack",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "alpha_mode": {
      "enum": [
        "straight",
        "premultiplied"
      ],
      "title": "Alpha Mode",
      "type": "string"
    },
    "anchor": {
      "$ref": "#/$defs/Point"
    },
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "camera_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Camera Id",
      "type": "string"
    },
    "canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "document_type": {
      "const": "action_pack",
      "title": "Document Type",
      "type": "string"
    },
    "fps": {
      "$ref": "#/$defs/FrameRate"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "outfit_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outfit Id"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "template": {
      "$ref": "#/$defs/AssetRef"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "document_type",
    "version",
    "camera_id",
    "template",
    "canvas",
    "anchor",
    "fps",
    "alpha_mode",
    "actions"
  ],
  "title": "ActionPack",
  "type": "object"
}
