{
  "$id": "urn:tabi:schema:1.0:compilation_result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "compilation_result",
      "default": "compilation_result",
      "title": "Document Type",
      "type": "string"
    },
    "duration_frames": {
      "exclusiveMinimum": 0,
      "title": "Duration Frames",
      "type": "integer"
    },
    "locked_inputs": {
      "minimum": 0,
      "title": "Locked Inputs",
      "type": "integer"
    },
    "purpose": {
      "enum": [
        "preview",
        "production",
        "synthetic_test"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "review_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Content Sha256",
      "type": "string"
    },
    "scheduled_events": {
      "minimum": 0,
      "title": "Scheduled Events",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_path": {
      "title": "Snapshot Path",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "snapshot_sha256",
    "snapshot_path",
    "review_content_sha256",
    "purpose",
    "duration_frames",
    "scheduled_events",
    "locked_inputs"
  ],
  "title": "CompilationResult",
  "type": "object"
}
