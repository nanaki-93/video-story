{
  "$defs": {
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "location": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Location",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggested_fix": {
          "minLength": 1,
          "title": "Suggested Fix",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "code",
        "location",
        "message",
        "suggested_fix"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:validation_report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "validation_report",
      "title": "Document Type",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "structure",
      "default": "structure",
      "title": "Scope",
      "type": "string"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "valid",
    "issues"
  ],
  "title": "ValidationReport",
  "type": "object"
}
