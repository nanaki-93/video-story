{
  "$defs": {
    "HashedFile": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/MediaPath"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "location",
        "sha256",
        "size_bytes"
      ],
      "title": "HashedFile",
      "type": "object"
    },
    "MediaPath": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "root_id": {
          "default": "project",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Root Id",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "MediaPath",
      "type": "object"
    },
    "ModelBinding": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/HashedFile"
        },
        "input_name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Input Name",
          "type": "string"
        },
        "node_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "server_name": {
          "title": "Server Name",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "input_name",
        "server_name",
        "file"
      ],
      "title": "ModelBinding",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:comfy_workflow",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "document_type": {
      "const": "comfy_workflow",
      "default": "comfy_workflow",
      "title": "Document Type",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ModelBinding"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "node_definitions": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 64,
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "title": "Node Definitions",
      "type": "object"
    },
    "output_nodes": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Output Nodes",
      "type": "array"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "synthetic_fixture": {
      "default": false,
      "title": "Synthetic Fixture",
      "type": "boolean"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/HashedFile"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "description",
    "workflow",
    "models",
    "node_definitions",
    "output_nodes"
  ],
  "title": "ComfyWorkflow",
  "type": "object"
}
