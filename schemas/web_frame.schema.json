{
  "$defs": {
    "AssemblyInfo": {
      "additionalProperties": false,
      "properties": {
        "chunk_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Chunk Sha256",
          "type": "array"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "mode": {
          "enum": [
            "stream_copy",
            "reencode"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "chunk_sha256"
      ],
      "title": "AssemblyInfo",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "AudioMixReport": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/Fingerprint"
        },
        "channels": {
          "const": 2,
          "default": 2,
          "title": "Channels",
          "type": "integer"
        },
        "document_type": {
          "const": "audio_mix_report",
          "default": "audio_mix_report",
          "title": "Document Type",
          "type": "string"
        },
        "first_sample": {
          "minimum": 0,
          "title": "First Sample",
          "type": "integer"
        },
        "gain_db": {
          "maximum": 24,
          "minimum": -120,
          "title": "Gain Db",
          "type": "number"
        },
        "integrated_lufs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Integrated Lufs"
        },
        "loudness_range_lu": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Loudness Range Lu"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "over_full_scale_samples": {
          "minimum": 0,
          "title": "Over Full Scale Samples",
          "type": "integer"
        },
        "preparations": {
          "items": {
            "$ref": "#/$defs/AudioPreparation"
          },
          "title": "Preparations",
          "type": "array"
        },
        "purpose": {
          "enum": [
            "preview",
            "production",
            "synthetic_test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "sample_count": {
          "exclusiveMinimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_format": {
          "const": "float32",
          "default": "float32",
          "title": "Sample Format",
          "type": "string"
        },
        "sample_peak_dbfs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Peak Dbfs"
        },
        "sample_rate": {
          "const": 48000,
          "default": 48000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "suggested_gain_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Suggested Gain Db"
        },
        "toolchain_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Toolchain Fingerprint",
          "type": "string"
        },
        "true_peak_dbtp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "True Peak Dbtp"
        },
        "verified_samples": {
          "title": "Verified Samples",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "snapshot_sha256",
        "purpose",
        "first_sample",
        "sample_count",
        "output_sha256",
        "backend",
        "toolchain_fingerprint",
        "preparations",
        "gain_db",
        "sample_peak_dbfs",
        "true_peak_dbtp",
        "integrated_lufs",
        "loudness_range_lu",
        "over_full_scale_samples",
        "suggested_gain_db",
        "warnings",
        "verified_samples"
      ],
      "title": "AudioMixReport",
      "type": "object"
    },
    "AudioPreparation": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/AssetRef"
        },
        "prepared_samples": {
          "exclusiveMinimum": 0,
          "title": "Prepared Samples",
          "type": "integer"
        },
        "resampled": {
          "title": "Resampled",
          "type": "boolean"
        },
        "source_sample_rate": {
          "exclusiveMinimum": 0,
          "title": "Source Sample Rate",
          "type": "integer"
        },
        "source_samples": {
          "exclusiveMinimum": 0,
          "title": "Source Samples",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset",
        "source_sha256",
        "source_sample_rate",
        "source_samples",
        "prepared_samples",
        "resampled"
      ],
      "title": "AudioPreparation",
      "type": "object"
    },
    "AudioVerification": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "const": 2,
          "default": 2,
          "title": "Channels",
          "type": "integer"
        },
        "codec": {
          "const": "aac",
          "default": "aac",
          "title": "Codec",
          "type": "string"
        },
        "decoded_samples": {
          "exclusiveMinimum": 0,
          "title": "Decoded Samples",
          "type": "integer"
        },
        "intended_samples": {
          "exclusiveMinimum": 0,
          "title": "Intended Samples",
          "type": "integer"
        },
        "padding_samples": {
          "minimum": 0,
          "title": "Padding Samples",
          "type": "integer"
        },
        "sample_rate": {
          "const": 48000,
          "default": 48000,
          "title": "Sample Rate",
          "type": "integer"
        }
      },
      "required": [
        "intended_samples",
        "decoded_samples",
        "padding_samples"
      ],
      "title": "AudioVerification",
      "type": "object"
    },
    "CacheReuse": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Key",
          "type": "string"
        },
        "origin_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Origin Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "key",
        "origin_snapshot_sha256"
      ],
      "title": "CacheReuse",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "FrameRate": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "exclusiveMinimum": 0,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "exclusiveMinimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "FrameRate",
      "type": "object"
    },
    "MP4Layout": {
      "additionalProperties": false,
      "properties": {
        "fast_start": {
          "const": true,
          "default": true,
          "title": "Fast Start",
          "type": "boolean"
        },
        "first_mdat_offset": {
          "minimum": 0,
          "title": "First Mdat Offset",
          "type": "integer"
        },
        "moov_offset": {
          "minimum": 0,
          "title": "Moov Offset",
          "type": "integer"
        }
      },
      "required": [
        "moov_offset",
        "first_mdat_offset"
      ],
      "title": "MP4Layout",
      "type": "object"
    },
    "RenderReport": {
      "additionalProperties": false,
      "properties": {
        "assembly": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssemblyInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audio_mix": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioMixReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audio_verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioVerification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backend": {
          "$ref": "#/$defs/Fingerprint"
        },
        "cache_reuse": {
          "anyOf": [
            {
              "$ref": "#/$defs/CacheReuse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "document_type": {
          "const": "render_report",
          "default": "render_report",
          "title": "Document Type",
          "type": "string"
        },
        "first_frame": {
          "minimum": 0,
          "title": "First Frame",
          "type": "integer"
        },
        "fps": {
          "$ref": "#/$defs/FrameRate"
        },
        "frame_count": {
          "exclusiveMinimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "full_decode_passed": {
          "title": "Full Decode Passed",
          "type": "boolean"
        },
        "graph_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Graph Sha256",
          "type": "string"
        },
        "normalized_cache_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Normalized Cache Hits",
          "type": "integer"
        },
        "normalized_images": {
          "minimum": 0,
          "title": "Normalized Images",
          "type": "integer"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "output_bytes": {
          "exclusiveMinimum": 0,
          "title": "Output Bytes",
          "type": "integer"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "preview",
            "production",
            "synthetic_test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "render_seconds": {
          "exclusiveMinimum": 0,
          "title": "Render Seconds",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "timestamps_verified": {
          "title": "Timestamps Verified",
          "type": "boolean"
        },
        "toolchain_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Toolchain Fingerprint",
          "type": "string"
        },
        "video_verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoVerification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "purpose",
        "snapshot_sha256",
        "first_frame",
        "frame_count",
        "canvas",
        "fps",
        "output",
        "output_sha256",
        "output_bytes",
        "graph_sha256",
        "backend",
        "toolchain_fingerprint",
        "render_seconds",
        "full_decode_passed",
        "timestamps_verified",
        "normalized_images"
      ],
      "title": "RenderReport",
      "type": "object"
    },
    "VideoVerification": {
      "additionalProperties": false,
      "properties": {
        "bit_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bit Rate"
        },
        "canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "codec": {
          "const": "h264",
          "default": "h264",
          "title": "Codec",
          "type": "string"
        },
        "color_range": {
          "const": "tv",
          "default": "tv",
          "title": "Color Range",
          "type": "string"
        },
        "color_space": {
          "const": "bt709",
          "default": "bt709",
          "title": "Color Space",
          "type": "string"
        },
        "container_duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Container Duration Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "fps": {
          "$ref": "#/$defs/FrameRate"
        },
        "frame_count": {
          "exclusiveMinimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "full_decode_passed": {
          "const": true,
          "default": true,
          "title": "Full Decode Passed",
          "type": "boolean"
        },
        "level": {
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "mp4": {
          "$ref": "#/$defs/MP4Layout"
        },
        "pixel_format": {
          "const": "yuv420p",
          "default": "yuv420p",
          "title": "Pixel Format",
          "type": "string"
        },
        "profile": {
          "const": "High",
          "default": "High",
          "title": "Profile",
          "type": "string"
        },
        "progressive": {
          "const": true,
          "default": true,
          "title": "Progressive",
          "type": "boolean"
        },
        "timestamps_verified": {
          "const": true,
          "default": true,
          "title": "Timestamps Verified",
          "type": "boolean"
        }
      },
      "required": [
        "level",
        "canvas",
        "fps",
        "frame_count",
        "duration_seconds",
        "container_duration_seconds",
        "mp4"
      ],
      "title": "VideoVerification",
      "type": "object"
    }
  },
  "$id": "urn:tabi:web:1:web_frame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "web_frame",
      "default": "web_frame",
      "title": "Document Type",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/RenderReport"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "report"
  ],
  "title": "WebFrame",
  "type": "object"
}
