{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "Continuity": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "object_notes": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Object Notes",
          "type": "object"
        },
        "objects": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "previous_episode_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Episode Id"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "title": "Continuity",
      "type": "object"
    },
    "Curve": {
      "additionalProperties": false,
      "properties": {
        "interpolation": {
          "enum": [
            "constant",
            "linear"
          ],
          "title": "Interpolation",
          "type": "string"
        },
        "keys": {
          "items": {
            "$ref": "#/$defs/CurveKey"
          },
          "minItems": 1,
          "title": "Keys",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/ParameterLimit"
        },
        "outside": {
          "default": "clamp",
          "enum": [
            "clamp",
            "zero"
          ],
          "title": "Outside",
          "type": "string"
        },
        "scope": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scope",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "unit": {
          "enum": [
            "design_px_per_second",
            "fraction",
            "degrees",
            "design_px",
            "db"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "target",
        "unit",
        "interpolation",
        "limits",
        "keys"
      ],
      "title": "Curve",
      "type": "object"
    },
    "CurveKey": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "frame",
        "value"
      ],
      "title": "CurveKey",
      "type": "object"
    },
    "LandmarkEvent": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/AssetRef"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "repeat": {
          "const": false,
          "default": false,
          "title": "Repeat",
          "type": "boolean"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "slot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Id"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "type": {
          "const": "landmark",
          "title": "Type",
          "type": "string"
        },
        "world_x": {
          "default": 0.0,
          "title": "World X",
          "type": "number"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "type",
        "id",
        "scene_id",
        "asset"
      ],
      "title": "LandmarkEvent",
      "type": "object"
    },
    "MusicBoundary": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "start",
            "end"
          ],
          "title": "Kind",
          "type": "string"
        },
        "placement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Placement Id",
          "type": "string"
        },
        "purposes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Purposes",
          "type": "array"
        },
        "sample": {
          "minimum": 0,
          "title": "Sample",
          "type": "integer"
        }
      },
      "required": [
        "placement_id",
        "sample",
        "kind",
        "purposes"
      ],
      "title": "MusicBoundary",
      "type": "object"
    },
    "ParameterLimit": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "ParameterLimit",
      "type": "object"
    },
    "PropEvent": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "location": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Location",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "type": {
          "const": "prop",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "scene_id",
        "frame",
        "object_id",
        "location"
      ],
      "title": "PropEvent",
      "type": "object"
    },
    "SceneInstance": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor"
        },
        "continuity": {
          "default": "preserve",
          "enum": [
            "preserve",
            "deliberate_reset"
          ],
          "title": "Continuity",
          "type": "string"
        },
        "curves": {
          "items": {
            "$ref": "#/$defs/Curve"
          },
          "title": "Curves",
          "type": "array"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "events": {
          "items": {
            "discriminator": {
              "mapping": {
                "landmark": "#/$defs/LandmarkEvent",
                "prop": "#/$defs/PropEvent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LandmarkEvent"
              },
              {
                "$ref": "#/$defs/PropEvent"
              }
            ]
          },
          "title": "Events",
          "type": "array"
        },
        "final_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "initial_state": {
          "$ref": "#/$defs/SceneState"
        },
        "purpose": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "slot_assignments": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
              "$ref": "#/$defs/AssetRef"
            }
          },
          "title": "Slot Assignments",
          "type": "object"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "template": {
          "$ref": "#/$defs/AssetRef"
        },
        "transition_in": {
          "$ref": "#/$defs/Transition"
        },
        "transition_out": {
          "$ref": "#/$defs/Transition"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "id",
        "template",
        "initial_state"
      ],
      "title": "SceneInstance",
      "type": "object"
    },
    "SceneState": {
      "additionalProperties": false,
      "properties": {
        "body_pose": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Body Pose",
          "type": "string"
        },
        "cabin_light": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cabin Light"
        },
        "facial_overlay": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Facial Overlay"
        },
        "props": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Props",
          "type": "object"
        },
        "travel_distance_px": {
          "default": 0.0,
          "minimum": 0,
          "title": "Travel Distance Px",
          "type": "number"
        },
        "weather_phase_frame": {
          "default": 0,
          "minimum": 0,
          "title": "Weather Phase Frame",
          "type": "integer"
        }
      },
      "required": [
        "body_pose"
      ],
      "title": "SceneState",
      "type": "object"
    },
    "StoryBeat": {
      "additionalProperties": false,
      "properties": {
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "music_placements": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Music Placements",
          "type": "array"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "id",
        "scene_id",
        "summary",
        "purpose"
      ],
      "title": "StoryBeat",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "character_policy": {
          "default": "cut",
          "enum": [
            "cut",
            "single_visible",
            "matched"
          ],
          "title": "Character Policy",
          "type": "string"
        },
        "kind": {
          "default": "cut",
          "enum": [
            "cut",
            "overlap"
          ],
          "title": "Kind",
          "type": "string"
        },
        "match_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "overlap_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Overlap Frames",
          "type": "integer"
        }
      },
      "title": "Transition",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "location": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Location",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggested_fix": {
          "minLength": 1,
          "title": "Suggested Fix",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "code",
        "location",
        "message",
        "suggested_fix"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:storyboard_report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "beats": {
      "items": {
        "$ref": "#/$defs/StoryBeat"
      },
      "title": "Beats",
      "type": "array"
    },
    "continuity": {
      "$ref": "#/$defs/Continuity"
    },
    "document_type": {
      "const": "storyboard_report",
      "default": "storyboard_report",
      "title": "Document Type",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "music_boundaries": {
      "items": {
        "$ref": "#/$defs/MusicBoundary"
      },
      "title": "Music Boundaries",
      "type": "array"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/SceneInstance"
      },
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "snapshot_sha256",
    "scenes",
    "beats",
    "music_boundaries",
    "continuity",
    "issues"
  ],
  "title": "StoryboardReport",
  "type": "object"
}
