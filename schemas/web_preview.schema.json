{
  "$defs": {
    "ActionRequest": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "body",
            "face"
          ],
          "title": "Channel",
          "type": "string"
        },
        "conflict_behavior": {
          "const": "error",
          "default": "error",
          "title": "Conflict Behavior",
          "type": "string"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "pack": {
          "$ref": "#/$defs/AssetRef"
        },
        "repeat": {
          "enum": [
            "once",
            "loop_to_fill"
          ],
          "title": "Repeat",
          "type": "string"
        },
        "return_pose": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Pose"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "id",
        "scene_id",
        "pack",
        "action_id",
        "version",
        "channel",
        "repeat"
      ],
      "title": "ActionRequest",
      "type": "object"
    },
    "AssetLock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetLock",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "ChunkPlan": {
      "additionalProperties": false,
      "properties": {
        "max_chunk_frames": {
          "exclusiveMinimum": 0,
          "maximum": 7200,
          "title": "Max Chunk Frames",
          "type": "integer"
        },
        "pipeline": {
          "$ref": "#/$defs/Fingerprint"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "temporal_handles": {
          "const": 0,
          "default": 0,
          "title": "Temporal Handles",
          "type": "integer"
        },
        "toolchain_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toolchain Fingerprint"
        },
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "pipeline",
        "profile_sha256",
        "max_chunk_frames"
      ],
      "title": "ChunkPlan",
      "type": "object"
    },
    "ChunkRecord": {
      "additionalProperties": false,
      "properties": {
        "first_frame": {
          "minimum": 0,
          "title": "First Frame",
          "type": "integer"
        },
        "frame_count": {
          "exclusiveMinimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashedFile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "state": {
          "enum": [
            "pending",
            "rendering",
            "verified",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "index",
        "first_frame",
        "frame_count",
        "state"
      ],
      "title": "ChunkRecord",
      "type": "object"
    },
    "Continuity": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "object_notes": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Object Notes",
          "type": "object"
        },
        "objects": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "previous_episode_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Episode Id"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "title": "Continuity",
      "type": "object"
    },
    "Curve": {
      "additionalProperties": false,
      "properties": {
        "interpolation": {
          "enum": [
            "constant",
            "linear"
          ],
          "title": "Interpolation",
          "type": "string"
        },
        "keys": {
          "items": {
            "$ref": "#/$defs/CurveKey"
          },
          "minItems": 1,
          "title": "Keys",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/ParameterLimit"
        },
        "outside": {
          "default": "clamp",
          "enum": [
            "clamp",
            "zero"
          ],
          "title": "Outside",
          "type": "string"
        },
        "scope": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scope",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "unit": {
          "enum": [
            "design_px_per_second",
            "fraction",
            "degrees",
            "design_px",
            "db"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "target",
        "unit",
        "interpolation",
        "limits",
        "keys"
      ],
      "title": "Curve",
      "type": "object"
    },
    "CurveKey": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "frame",
        "value"
      ],
      "title": "CurveKey",
      "type": "object"
    },
    "Episode": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/ActionRequest"
          },
          "title": "Actions",
          "type": "array"
        },
        "asset_locks": {
          "items": {
            "$ref": "#/$defs/AssetLock"
          },
          "title": "Asset Locks",
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/StoryBeat"
          },
          "title": "Beats",
          "type": "array"
        },
        "canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "continuity": {
          "$ref": "#/$defs/Continuity"
        },
        "curves": {
          "items": {
            "$ref": "#/$defs/Curve"
          },
          "title": "Curves",
          "type": "array"
        },
        "document_type": {
          "const": "episode",
          "title": "Document Type",
          "type": "string"
        },
        "duration_frames": {
          "exclusiveMinimum": 0,
          "minimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "events": {
          "items": {
            "discriminator": {
              "mapping": {
                "landmark": "#/$defs/LandmarkEvent",
                "prop": "#/$defs/PropEvent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LandmarkEvent"
              },
              {
                "$ref": "#/$defs/PropEvent"
              }
            ]
          },
          "title": "Events",
          "type": "array"
        },
        "format": {
          "enum": [
            "story",
            "session",
            "track"
          ],
          "title": "Format",
          "type": "string"
        },
        "fps": {
          "$ref": "#/$defs/FrameRate"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "random_actions": {
          "items": {
            "$ref": "#/$defs/RandomActionTiming"
          },
          "title": "Random Actions",
          "type": "array"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/SceneInstance"
          },
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/TrackPlacement"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "id",
        "document_type",
        "title",
        "format",
        "fps",
        "canvas",
        "duration_frames",
        "seed",
        "scenes"
      ],
      "title": "Episode",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "FrameRate": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "exclusiveMinimum": 0,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "exclusiveMinimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "FrameRate",
      "type": "object"
    },
    "HashedFile": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/MediaPath"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "location",
        "sha256",
        "size_bytes"
      ],
      "title": "HashedFile",
      "type": "object"
    },
    "JobError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "log_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Path"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "JobError",
      "type": "object"
    },
    "LandmarkEvent": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/AssetRef"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "repeat": {
          "const": false,
          "default": false,
          "title": "Repeat",
          "type": "boolean"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "slot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Id"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "type": {
          "const": "landmark",
          "title": "Type",
          "type": "string"
        },
        "world_x": {
          "default": 0.0,
          "title": "World X",
          "type": "number"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "type",
        "id",
        "scene_id",
        "asset"
      ],
      "title": "LandmarkEvent",
      "type": "object"
    },
    "MediaPath": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "root_id": {
          "default": "project",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Root Id",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "MediaPath",
      "type": "object"
    },
    "OutputProfile": {
      "additionalProperties": false,
      "properties": {
        "audio_bitrate": {
          "default": 192000,
          "maximum": 512000,
          "minimum": 64000,
          "title": "Audio Bitrate",
          "type": "integer"
        },
        "audio_codec": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Codec"
        },
        "audio_gain_db": {
          "default": 0.0,
          "maximum": 24,
          "minimum": -120,
          "title": "Audio Gain Db",
          "type": "number"
        },
        "canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "color_space": {
          "const": "bt709",
          "title": "Color Space",
          "type": "string"
        },
        "container": {
          "enum": [
            "mp4",
            "mkv"
          ],
          "title": "Container",
          "type": "string"
        },
        "fps": {
          "$ref": "#/$defs/FrameRate"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "pixel_format": {
          "minLength": 1,
          "title": "Pixel Format",
          "type": "string"
        },
        "sample_rate": {
          "const": 48000,
          "default": 48000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "video_bitrate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Bitrate"
        },
        "video_codec": {
          "minLength": 1,
          "title": "Video Codec",
          "type": "string"
        }
      },
      "required": [
        "id",
        "canvas",
        "fps",
        "container",
        "video_codec",
        "pixel_format",
        "color_space"
      ],
      "title": "OutputProfile",
      "type": "object"
    },
    "ParameterLimit": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "ParameterLimit",
      "type": "object"
    },
    "PreviewMarker": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "note": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "snapshot_sha256",
        "frame",
        "note"
      ],
      "title": "PreviewMarker",
      "type": "object"
    },
    "PreviewSelection": {
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "const": "preview_selection",
          "default": "preview_selection",
          "title": "Document Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Job Id",
          "type": "string"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/PreviewMarker"
          },
          "maxItems": 10000,
          "title": "Markers",
          "type": "array"
        },
        "pipeline": {
          "$ref": "#/$defs/Fingerprint"
        },
        "previous_job_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Job Id"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "snapshot_sha256",
        "pipeline",
        "job_id"
      ],
      "title": "PreviewSelection",
      "type": "object"
    },
    "PropEvent": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "location": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
