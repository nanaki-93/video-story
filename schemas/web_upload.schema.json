{
  "$id": "urn:tabi:web:1:web_upload",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "complete": {
      "default": false,
      "title": "Complete",
      "type": "boolean"
    },
    "document_type": {
      "const": "web_upload",
      "default": "web_upload",
      "title": "Document Type",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "received_bytes": {
      "minimum": 0,
      "title": "Received Bytes",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "size_bytes",
    "received_bytes"
  ],
  "title": "WebUpload",
  "type": "object"
}
