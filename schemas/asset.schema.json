{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Approval",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cameras": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Cameras",
          "type": "array"
        },
        "channels": {
          "items": {
            "enum": [
              "body",
              "face"
            ],
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outfits": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Outfits",
          "type": "array"
        },
        "pivot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "templates": {
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "title": "Templates",
          "type": "array"
        }
      },
      "title": "Compatibility",
      "type": "object"
    },
    "Crop": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Crop",
      "type": "object"
    },
    "FrameRate": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "exclusiveMinimum": 0,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "exclusiveMinimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "FrameRate",
      "type": "object"
    },
    "GenerationRecord": {
      "additionalProperties": false,
      "properties": {
        "model_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Sha256"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "workflow": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workflow_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Sha256"
        }
      },
      "title": "GenerationRecord",
      "type": "object"
    },
    "HashedFile": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/MediaPath"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "location",
        "sha256",
        "size_bytes"
      ],
      "title": "HashedFile",
      "type": "object"
    },
    "MediaPath": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "root_id": {
          "default": "project",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Root Id",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "MediaPath",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "ProbeData": {
      "additionalProperties": false,
      "properties": {
        "alpha_mode": {
          "default": "unknown",
          "enum": [
            "none",
            "straight",
            "premultiplied",
            "unknown"
          ],
          "title": "Alpha Mode",
          "type": "string"
        },
        "canvas": {
          "anyOf": [
            {
              "$ref": "#/$defs/Canvas"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "channels": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "codec": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codec"
        },
        "color_space": {
          "default": "unknown",
          "enum": [
            "srgb",
            "bt709",
            "grayscale",
            "unknown"
          ],
          "title": "Color Space",
          "type": "string"
        },
        "duration_samples": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Samples"
        },
        "fps": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frame_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Count"
        },
        "pixel_aspect": {
          "$ref": "#/$defs/FrameRate"
        },
        "pixel_format": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Format"
        },
        "sample_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        }
      },
      "title": "ProbeData",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "commercial_use": {
          "default": "pending",
          "enum": [
            "pending",
            "confirmed",
            "not-permitted"
          ],
          "title": "Commercial Use",
          "type": "string"
        },
        "creator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creator"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "licence_evidence": {
          "items": {
            "$ref": "#/$defs/MediaPath"
          },
          "title": "Licence Evidence",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "origin": {
          "default": "unknown",
          "enum": [
            "unknown",
            "user_supplied",
            "synthetic",
            "generated"
          ],
          "title": "Origin",
          "type": "string"
        },
        "reference_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Reference Ids",
          "type": "array"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:asset",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "compatibility": {
      "$ref": "#/$defs/Compatibility"
    },
    "document_type": {
      "const": "asset",
      "title": "Document Type",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/HashedFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "still",
        "mask",
        "sequence",
        "video",
        "audio",
        "font"
      ],
      "title": "Kind",
      "type": "string"
    },
    "probe": {
      "$ref": "#/$defs/ProbeData"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "proxies": {
      "items": {
        "$ref": "#/$defs/HashedFile"
      },
      "title": "Proxies",
      "type": "array"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/MediaPath"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "document_type",
    "version",
    "kind",
    "source",
    "files",
    "probe"
  ],
  "title": "Asset",
  "type": "object"
}
