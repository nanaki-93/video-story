{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Approval",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "LayerSlot": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor"
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "depth_factor": {
          "default": 1.0,
          "minimum": 0,
          "title": "Depth Factor",
          "type": "number"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "still",
            "tile_strip",
            "scheduled_sprite",
            "character",
            "effect"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "tile_period": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tile Period"
        },
        "z": {
          "minimum": 0,
          "title": "Z",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "z",
        "kind"
      ],
      "title": "LayerSlot",
      "type": "object"
    },
    "ParameterLimit": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "ParameterLimit",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:scene_template",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchors": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "$ref": "#/$defs/Point"
        }
      },
      "title": "Anchors",
      "type": "object"
    },
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "camera_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Camera Id",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "channels": {
      "items": {
        "enum": [
          "body",
          "face"
        ],
        "type": "string"
      },
      "title": "Channels",
      "type": "array"
    },
    "design_canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "document_type": {
      "const": "scene_template",
      "title": "Document Type",
      "type": "string"
    },
    "fit": {
      "default": "letterbox",
      "enum": [
        "crop",
        "letterbox"
      ],
      "title": "Fit",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "mask_semantics": {
      "const": "white_visible_black_hidden",
      "title": "Mask Semantics",
      "type": "string"
    },
    "parameter_limits": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "$ref": "#/$defs/ParameterLimit"
        }
      },
      "title": "Parameter Limits",
      "type": "object"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slots": {
      "items": {
        "$ref": "#/$defs/LayerSlot"
      },
      "minItems": 1,
      "title": "Slots",
      "type": "array"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "document_type",
    "version",
    "camera_id",
    "design_canvas",
    "capabilities",
    "channels",
    "anchors",
    "slots",
    "mask_semantics"
  ],
  "title": "SceneTemplate",
  "type": "object"
}
