{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "FrameInterval": {
      "additionalProperties": false,
      "properties": {
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        }
      },
      "required": [
        "start_frame",
        "end_frame"
      ],
      "title": "FrameInterval",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:action",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "enum": [
        "body",
        "face"
      ],
      "title": "Channel",
      "type": "string"
    },
    "clip": {
      "$ref": "#/$defs/AssetRef"
    },
    "compatible_body_poses": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "title": "Compatible Body Poses",
      "type": "array"
    },
    "end_pose": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "End Pose",
      "type": "string"
    },
    "frame_count": {
      "exclusiveMinimum": 0,
      "title": "Frame Count",
      "type": "integer"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "loop",
        "one_shot"
      ],
      "title": "Kind",
      "type": "string"
    },
    "loop": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrameInterval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occupies_channels": {
      "items": {
        "enum": [
          "body",
          "face"
        ],
        "type": "string"
      },
      "title": "Occupies Channels",
      "type": "array"
    },
    "requires_props": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        }
      },
      "title": "Requires Props",
      "type": "object"
    },
    "resulting_props": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        }
      },
      "title": "Resulting Props",
      "type": "object"
    },
    "start_pose": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Start Pose",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "channel",
    "start_pose",
    "end_pose",
    "kind",
    "frame_count",
    "clip"
  ],
  "title": "Action",
  "type": "object"
}
