{
  "$defs": {
    "Project": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "document_type": {
          "const": "project",
          "title": "Document Type",
          "type": "string"
        },
        "episode_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Episode Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "media_roots": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
              "type": "string"
            }
          },
          "title": "Media Roots",
          "type": "object"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "root": {
          "const": ".",
          "default": ".",
          "title": "Root",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "document_type",
        "title",
        "created_at",
        "updated_at"
      ],
      "title": "Project",
      "type": "object"
    },
    "WebProject": {
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "const": "web_project",
          "default": "web_project",
          "title": "Document Type",
          "type": "string"
        },
        "handle": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Handle",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "project": {
          "$ref": "#/$defs/Project"
        },
        "root_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Root Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "handle",
        "root_id",
        "path",
        "project"
      ],
      "title": "WebProject",
      "type": "object"
    }
  },
  "$id": "urn:tabi:web:1:web_projects",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "web_projects",
      "default": "web_projects",
      "title": "Document Type",
      "type": "string"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/WebProject"
      },
      "title": "Projects",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "projects"
  ],
  "title": "WebProjects",
  "type": "object"
}
