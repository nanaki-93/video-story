{
  "$defs": {
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "directory",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "name",
        "path",
        "kind"
      ],
      "title": "FileEntry",
      "type": "object"
    }
  },
  "$id": "urn:tabi:web:1:web_directory",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "web_directory",
      "default": "web_directory",
      "title": "Document Type",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/FileEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "next_offset": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Offset"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "root_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Root Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "root_id",
    "path",
    "entries"
  ],
  "title": "WebDirectory",
  "type": "object"
}
