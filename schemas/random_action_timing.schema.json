{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:random_action_timing",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Action Id",
      "type": "string"
    },
    "channel": {
      "enum": [
        "body",
        "face"
      ],
      "title": "Channel",
      "type": "string"
    },
    "duration_frames": {
      "exclusiveMinimum": 0,
      "title": "Duration Frames",
      "type": "integer"
    },
    "end_frame": {
      "minimum": 0,
      "title": "End Frame",
      "type": "integer"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "maximum_gap_frames": {
      "exclusiveMinimum": 0,
      "title": "Maximum Gap Frames",
      "type": "integer"
    },
    "minimum_gap_frames": {
      "exclusiveMinimum": 0,
      "title": "Minimum Gap Frames",
      "type": "integer"
    },
    "pack": {
      "$ref": "#/$defs/AssetRef"
    },
    "repeat": {
      "default": "once",
      "enum": [
        "once",
        "loop_to_fill"
      ],
      "title": "Repeat",
      "type": "string"
    },
    "scene_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Scene Id",
      "type": "string"
    },
    "start_frame": {
      "minimum": 0,
      "title": "Start Frame",
      "type": "integer"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "start_frame",
    "end_frame",
    "id",
    "scene_id",
    "pack",
    "action_id",
    "version",
    "channel",
    "duration_frames",
    "minimum_gap_frames",
    "maximum_gap_frames"
  ],
  "title": "RandomActionTiming",
  "type": "object"
}
