{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "Chapter": {
      "additionalProperties": false,
      "properties": {
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "start_frame",
        "title"
      ],
      "title": "Chapter",
      "type": "object"
    },
    "ReleasePreparation": {
      "additionalProperties": false,
      "properties": {
        "chapters": {
          "items": {
            "$ref": "#/$defs/Chapter"
          },
          "title": "Chapters",
          "type": "array"
        },
        "claim_notes": {
          "default": "",
          "title": "Claim Notes",
          "type": "string"
        },
        "concept_notes": {
          "default": "",
          "title": "Concept Notes",
          "type": "string"
        },
        "creative_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "disclosure_notes": {
          "default": "",
          "title": "Disclosure Notes",
          "type": "string"
        },
        "document_type": {
          "const": "release_preparation",
          "default": "release_preparation",
          "title": "Document Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Job Id",
          "type": "string"
        },
        "manual_links": {
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Manual Links",
          "type": "array"
        },
        "metadata_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "const": "layered",
          "default": "layered",
          "title": "Source Kind",
          "type": "string"
        },
        "thumbnail": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "job_id",
        "title"
      ],
      "title": "ReleasePreparation",
      "type": "object"
    },
    "ReviewRecord": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "reviewed_at",
        "content_sha256"
      ],
      "title": "ReviewRecord",
      "type": "object"
    }
  },
  "$id": "urn:tabi:web:1:web_releases",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "web_releases",
      "default": "web_releases",
      "title": "Document Type",
      "type": "string"
    },
    "preparations": {
      "items": {
        "$ref": "#/$defs/ReleasePreparation"
      },
      "title": "Preparations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "preparations"
  ],
  "title": "WebReleases",
  "type": "object"
}
