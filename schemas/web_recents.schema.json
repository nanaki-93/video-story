{
  "$defs": {
    "RecentProject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "root_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Root Id",
          "type": "string"
        },
        "root_path": {
          "minLength": 1,
          "title": "Root Path",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "root_id",
        "root_path",
        "path",
        "id",
        "title"
      ],
      "title": "RecentProject",
      "type": "object"
    }
  },
  "$id": "urn:tabi:web:1:web_recents",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "web_recents",
      "default": "web_recents",
      "title": "Document Type",
      "type": "string"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/RecentProject"
      },
      "maxItems": 30,
      "title": "Projects",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "projects"
  ],
  "title": "WebRecents",
  "type": "object"
}
