{
  "$defs": {
    "FlowBeat": {
      "additionalProperties": false,
      "properties": {
        "district": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rest",
            "look",
            "pickup",
            "sip",
            "return_cup",
            "sway",
            "deep_breath",
            "district"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_frame": {
          "minimum": 0,
          "title": "Target Frame",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "target_frame"
      ],
      "title": "FlowBeat",
      "type": "object"
    }
  },
  "$id": "urn:tabi:schema:1.0:flow_attempt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "beat": {
      "$ref": "#/$defs/FlowBeat"
    },
    "diagnostic": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diagnostic"
    },
    "document_type": {
      "const": "flow_attempt",
      "default": "flow_attempt",
      "title": "Document Type",
      "type": "string"
    },
    "episode_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Episode Id",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "text_reference",
        "image_motion",
        "extend",
        "shot_start"
      ],
      "title": "Mode",
      "type": "string"
    },
    "observed_credits": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Credits"
    },
    "parent_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "parent_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Sha256"
    },
    "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "provider_clip_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Clip Id"
    },
    "provider_model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Model"
    },
    "recipe_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recipe Sha256",
      "type": "string"
    },
    "references_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "References Sha256",
      "type": "string"
    },
    "reserved_credits": {
      "minimum": 0,
      "title": "Reserved Credits",
      "type": "integer"
    },
    "retry_index": {
      "default": 0,
      "minimum": 0,
      "title": "Retry Index",
      "type": "integer"
    },
    "retry_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Reason"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shot_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shot Id"
    },
    "state": {
      "enum": [
        "prepared",
        "awaiting_external",
        "submitted",
        "unknown",
        "received",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "template_version": {
      "default": "1",
      "enum": [
        "1",
        "2"
      ],
      "title": "Template Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "episode_id",
    "recipe_sha256",
    "references_sha256",
    "beat",
    "mode",
    "prompt",
    "prompt_sha256",
    "state",
    "reserved_credits"
  ],
  "title": "FlowAttempt",
  "type": "object"
}
