{
  "$defs": {
    "ActionRequest": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "body",
            "face"
          ],
          "title": "Channel",
          "type": "string"
        },
        "conflict_behavior": {
          "const": "error",
          "default": "error",
          "title": "Conflict Behavior",
          "type": "string"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "pack": {
          "$ref": "#/$defs/AssetRef"
        },
        "repeat": {
          "enum": [
            "once",
            "loop_to_fill"
          ],
          "title": "Repeat",
          "type": "string"
        },
        "return_pose": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Pose"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "id",
        "scene_id",
        "pack",
        "action_id",
        "version",
        "channel",
        "repeat"
      ],
      "title": "ActionRequest",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Approval",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "$ref": "#/$defs/Approval"
        },
        "compatibility": {
          "$ref": "#/$defs/Compatibility"
        },
        "document_type": {
          "const": "asset",
          "title": "Document Type",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/HashedFile"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "still",
            "mask",
            "sequence",
            "video",
            "audio",
            "font"
          ],
          "title": "Kind",
          "type": "string"
        },
        "probe": {
          "$ref": "#/$defs/ProbeData"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "proxies": {
          "items": {
            "$ref": "#/$defs/HashedFile"
          },
          "title": "Proxies",
          "type": "array"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/MediaPath"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "document_type",
        "version",
        "kind",
        "source",
        "files",
        "probe"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetLock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetLock",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "AudioSource": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/Asset"
        },
        "prepared_samples": {
          "minimum": 0,
          "title": "Prepared Samples",
          "type": "integer"
        }
      },
      "required": [
        "asset",
        "prepared_samples"
      ],
      "title": "AudioSource",
      "type": "object"
    },
    "AudioTimelineReport": {
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "const": "audio_timeline_report",
          "default": "audio_timeline_report",
          "title": "Document Type",
          "type": "string"
        },
        "duration_samples": {
          "exclusiveMinimum": 0,
          "title": "Duration Samples",
          "type": "integer"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "music_gaps": {
          "items": {
            "$ref": "#/$defs/SampleRange"
          },
          "title": "Music Gaps",
          "type": "array"
        },
        "placements": {
          "items": {
            "$ref": "#/$defs/TrackPlacement"
          },
          "title": "Placements",
          "type": "array"
        },
        "sample_rate": {
          "const": 48000,
          "default": 48000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "duration_samples",
        "placements",
        "music_gaps",
        "issues"
      ],
      "title": "AudioTimelineReport",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cameras": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Cameras",
          "type": "array"
        },
        "channels": {
          "items": {
            "enum": [
              "body",
              "face"
            ],
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outfits": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Outfits",
          "type": "array"
        },
        "pivot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "templates": {
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "title": "Templates",
          "type": "array"
        }
      },
      "title": "Compatibility",
      "type": "object"
    },
    "Continuity": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "object_notes": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Object Notes",
          "type": "object"
        },
        "objects": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "previous_episode_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Episode Id"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "title": "Continuity",
      "type": "object"
    },
    "Crop": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Crop",
      "type": "object"
    },
    "Curve": {
      "additionalProperties": false,
      "properties": {
        "interpolation": {
          "enum": [
            "constant",
            "linear"
          ],
          "title": "Interpolation",
          "type": "string"
        },
        "keys": {
          "items": {
            "$ref": "#/$defs/CurveKey"
          },
          "minItems": 1,
          "title": "Keys",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/ParameterLimit"
        },
        "outside": {
          "default": "clamp",
          "enum": [
            "clamp",
            "zero"
          ],
          "title": "Outside",
          "type": "string"
        },
        "scope": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scope",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "unit": {
          "enum": [
            "design_px_per_second",
            "fraction",
            "degrees",
            "design_px",
            "db"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "target",
        "unit",
        "interpolation",
        "limits",
        "keys"
      ],
      "title": "Curve",
      "type": "object"
    },
    "CurveKey": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "frame",
        "value"
      ],
      "title": "CurveKey",
      "type": "object"
    },
    "Episode": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/ActionRequest"
          },
          "title": "Actions",
          "type": "array"
        },
        "asset_locks": {
          "items": {
            "$ref": "#/$defs/AssetLock"
          },
          "title": "Asset Locks",
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/StoryBeat"
          },
          "title": "Beats",
          "type": "array"
        },
        "canvas": {
          "$ref": "#/$defs/Canvas"
        },
        "continuity": {
          "$ref": "#/$defs/Continuity"
        },
        "curves": {
          "items": {
            "$ref": "#/$defs/Curve"
          },
          "title": "Curves",
          "type": "array"
        },
        "document_type": {
          "const": "episode",
          "title": "Document Type",
          "type": "string"
        },
        "duration_frames": {
          "exclusiveMinimum": 0,
          "minimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "events": {
          "items": {
            "discriminator": {
              "mapping": {
                "landmark": "#/$defs/LandmarkEvent",
                "prop": "#/$defs/PropEvent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LandmarkEvent"
              },
              {
                "$ref": "#/$defs/PropEvent"
              }
            ]
          },
          "title": "Events",
          "type": "array"
        },
        "format": {
          "enum": [
            "story",
            "session",
            "track"
          ],
          "title": "Format",
          "type": "string"
        },
        "fps": {
          "$ref": "#/$defs/FrameRate"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "random_actions": {
          "items": {
            "$ref": "#/$defs/RandomActionTiming"
          },
          "title": "Random Actions",
          "type": "array"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/SceneInstance"
          },
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/TrackPlacement"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "id",
        "document_type",
        "title",
        "format",
        "fps",
        "canvas",
        "duration_frames",
        "seed",
        "scenes"
      ],
      "title": "Episode",
      "type": "object"
    },
    "FrameRate": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "exclusiveMinimum": 0,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "exclusiveMinimum": 0,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "title": "FrameRate",
      "type": "object"
    },
    "GenerationRecord": {
      "additionalProperties": false,
      "properties": {
        "model_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Sha256"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "workflow": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workflow_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Sha256"
        }
      },
      "title": "GenerationRecord",
      "type": "object"
    },
    "HashedFile": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/MediaPath"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "location",
        "sha256",
        "size_bytes"
      ],
      "title": "HashedFile",
      "type": "object"
    },
    "LandmarkEvent": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/AssetRef"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "repeat": {
          "const": false,
          "default": false,
          "title": "Repeat",
          "type": "boolean"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "slot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Id"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "type": {
          "const": "landmark",
          "title": "Type",
          "type": "string"
        },
        "world_x": {
          "default": 0.0,
          "title": "World X",
          "type": "number"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "type",
        "id",
        "scene_id",
        "asset"
      ],
      "title": "LandmarkEvent",
      "type": "object"
    },
    "MediaPath": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "root_id": {
          "default": "project",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Root Id",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "MediaPath",
      "type": "object"
    },
    "ParameterLimit": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
